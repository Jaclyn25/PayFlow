{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=payflow_db;Username=postgres;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "FeeSettings": {
    "Enabled": true,
    "Percentage": 0.01,
    "FixedFee": 0.30,
    "CapAmount": 50.00,
    "MinFee": 0.00
  },
  "KycSettings": {
    "Enabled": true,
    "TierLimits": {
      "Unverified": { "MaxSingleTransaction": 1000.0, "DailyLimit": 2500.0, "MonthlyLimit": 10000.0 },
      "Tier1": { "MaxSingleTransaction": 5000.0, "DailyLimit": 15000.0, "MonthlyLimit": 50000.0 },
      "Tier2": { "MaxSingleTransaction": 50000.0, "DailyLimit": 150000.0, "MonthlyLimit": 500000.0 },
      "Tier3": { "MaxSingleTransaction": 500000.0, "DailyLimit": 2000000.0, "MonthlyLimit": 10000000.0 }
    }
  },
  "TwoFactorSettings": {
    "Issuer": "PayFlow",
    "ClockDriftToleranceSteps": 1,
    "StepSizeSeconds": 30,
    "Digits": 6,
    "RecoveryCodesCount": 10,
    "StepUpTransferThreshold": 5000.00,
    "RequireStepUpForTransfers": true
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "PayFlow.Api",
    "Audience": "PayFlow.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "payflow.events",
    "QueueName": "payflow.notifications",
    "RoutingKey": "transfer.completed",
    "DeadLetterExchangeName": "payflow.dlx",
    "DeadLetterQueueName": "payflow.notifications.dlq",
    "DeadLetterRoutingKey": "payflow.notifications.dlq",
    "MaxRetryAttempts": 3,
    "InitialRetryDelaySeconds": 2.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
